NERDB_API_KEY=
NERDB_URL=https://nerdb.com.br
LLAMA_URL=http://127.0.0.1:8080

PORT=3000

# Escolha o provedor: 'local' (llama-server) ou 'gemini'
LLM_PROVIDER=

# Obrigatório se LLM_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_do_google_ai_studio
GEMINI_MODEL=

# Níveis aceitos: 'minimal', 'low', 'medium', 'high'
GEMINI_THINKING_TRANSLATION=low
GEMINI_THINKING_SYNOPSIS=high
# Delay de 4.5 segundos entre cada requisição para respeitar os limites de RPM
GEMINI_DELAY_MS=4500

# Opcionais
BATCH=20          # textos por chamada à IA
MIN_COUNT=3       # só traduz textos que aparecem pelo menos N vezes (corta nomes próprios)
CONCURRENCY=1     # PATCHs simultâneos no apply
DATA_DIR=data